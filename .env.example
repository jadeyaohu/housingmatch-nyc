# Supabase — leave blank to use data/listings.json
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only (importer, cron jobs, Stripe webhook). Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Beta auth is OFF until approved per-environment resources are supplied.
NEXT_PUBLIC_AUTH_ENABLED=false
NEXT_PUBLIC_AUTH_SUPABASE_URL=
NEXT_PUBLIC_AUTH_SUPABASE_KEY=
NEXT_PUBLIC_GOOGLE_AUTH=0
NEXT_PUBLIC_EMAIL_AUTH=0
# Optional synthetic LOCAL/CI catalog; forbidden when VERCEL_ENV=production.
BETA_FIXTURES=

# Pricing v3. These flags do not grant release approval. Approved NONPRODUCTION resources only.
BETA_SERVICES_ENABLED=false
BETA_NONPRODUCTION_APPROVED=false
BETA_APP_ORIGIN=
# Must match the approved Auth project above. Service role is server-only.
BETA_SUPABASE_URL=
BETA_SUPABASE_SERVICE_ROLE_KEY=
CHAT_ENABLED=false
CHAT_UPSTREAM_REVIEWED=false
CHAT_DATA_POLICY_APPROVED=false
CHAT_APPS_SCRIPT_URL=
SUBSCRIPTIONS_ENABLED=false
SUBSCRIPTIONS_STRIPE_SECRET_KEY=
SUBSCRIPTIONS_STRIPE_WEBHOOK_SECRET=
# Nonsecret actual TEST account/catalog IDs; obtain from the guarded catalog script, never invent.
SUBSCRIPTIONS_STRIPE_TEST_ACCOUNT_ID=
SUBSCRIPTIONS_STRIPE_BASIC_PRICE_ID=
SUBSCRIPTIONS_STRIPE_SMART_PRICE_ID=
# Opt-in local dataLayer foundation, evaluated at build time. No GTM container installed.
NEXT_PUBLIC_GTM_EVENTS_ENABLED=false
# Legacy consultation Stripe payment routes remain retired (410). Native intake is configured below.

# Native consultation — approved NONPRODUCTION test recipients only; no live payments.
CONSULTATION_BOOKING_ENABLED=false
CONSULTATION_POLICIES_APPROVED=false
CONSULTATION_NONPRODUCTION_APPROVED=false
CONSULTATION_APP_ORIGIN=
CONSULTATION_SUPABASE_URL=
CONSULTATION_SUPABASE_SERVICE_ROLE_KEY=
CONSULTATION_TEST_RECIPIENTS=
CONSULTATION_EMAIL_TEST_ENABLED=false
CONSULTATION_EMAIL_FROM=
CONSULTATION_RESEND_API_KEY=
CONSULTATION_PAYMENT_INSTRUCTIONS_APPROVED=false
CONSULTATION_PAYMENT_INSTRUCTIONS_EN=
CONSULTATION_PAYMENT_INSTRUCTIONS_ZH=
CONSULTATION_MANUAL_TEST_VERIFICATION_ENABLED=false
CONSULTATION_SCHEDULING_APPROVED=false
CONSULTATION_TEST_SCHEDULING_URL=
# Optional LOCAL synthetic Preview journey; automatic on Vercel Preview, forbidden in Production.
BETA_PREVIEW_DEMO=false
