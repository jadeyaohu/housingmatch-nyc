# Supabase — leave blank to use data/listings.json
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only (importer, cron jobs, Stripe webhook). Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Later phases
RESEND_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PLUS_MONTHLY=

# Consultation MVP — explicitly disabled until local/dev database and policy review are ready.
# Dedicated server-only project settings; never use a NEXT_PUBLIC service-role variable.
CONSULTATION_BOOKING_ENABLED=false
CONSULTATION_POLICIES_APPROVED=false
CONSULTATION_SUPABASE_URL=
CONSULTATION_SUPABASE_SERVICE_ROLE_KEY=

# Phase 2 consultation payments — test mode only, disabled by default.
CONSULTATION_STRIPE_ENABLED=false
CONSULTATION_APP_ORIGIN=
CONSULTATION_STRIPE_SECRET_KEY=
CONSULTATION_STRIPE_WEBHOOK_SECRET=
