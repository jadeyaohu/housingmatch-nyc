# Supabase — leave blank to use data/listings.json
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only (importer, cron jobs, Stripe webhook). Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Analytics ingestion (HN-001). Off unless exactly "true". Set real values only in
# Vercel/GitHub environment settings — never commit them or paste them in issues/chats.
ANALYTICS_INGEST_ENABLED=
# Required in addition on Vercel production; leave unset until the Product Owner approves launch.
ANALYTICS_PRODUCTION_APPROVED=
# Upstash rate limiter (server-only). Ingestion fails closed if any is missing.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Random secret (>= 32 bytes) used to HMAC client IPs into limiter keys. Server-only.
RATE_LIMIT_HMAC_SECRET=

# Later phases
RESEND_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PLUS_MONTHLY=
